// facilitatorx402 — Prisma Schema V2
// PostgreSQL ONLY — no SQLite fallback.
// Run: npx prisma migrate dev --name v2-add-webhook-secret-and-indexes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Seller ──────────────────────────────────────────────────────────────────
// Represents an operator that integrates with this facilitator.
// apiKeyHash stores SHA-256(rawApiKey) — never the key in clear.

model Seller {
  id             String     @id @default(cuid())
  name           String
  apiKeyHash     String     @unique
  walletAddress  String     @unique
  referralCode   String?    @db.VarChar(50)
  deviceType     DeviceType @default(server)
  webhookUrl     String?    // Deprecated in V2 — use WebhookSubscription instead
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  paymentRequests       PaymentRequest[]
  webhookSubscriptions  WebhookSubscription[]

  @@map("sellers")
}

enum DeviceType {
  server
  robot
  iot
  agent
}

// ─── Network & Asset (dynamic, admin-managed) ─────────────────────────────────
// V2: supports multiple networks simultaneously (Base, Optimism, Arbitrum)
// V2: supports multiple assets per network (USDC, EURC)

model Network {
  id              String   @id @default(cuid())
  chainId         Int      @unique
  name            String   @unique @db.VarChar(64)
  rpcUrl          String
  fallbackRpcUrl  String?
  nativeCurrency  String   @default("ETH")
  blockExplorer   String
  active          Boolean  @default(true)
  addedBy         String   @default("system")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assets          NetworkAsset[]
  paymentRequests PaymentRequest[]

  @@map("networks")
}

model NetworkAsset {
  id         String   @id @default(cuid())
  networkId  String
  symbol     String   @db.VarChar(20)
  address    String   @db.VarChar(42)
  decimals   Int      @default(6)
  minAmount  String   @default("1")
  maxAmount  String   @default("1000000000")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  network    Network  @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, symbol])
  @@unique([networkId, address])
  @@map("network_assets")
}

// ─── Payment Request ──────────────────────────────────────────────────────────

model PaymentRequest {
  id            String   @id @default(cuid())
  sellerId      String?
  buyerAddress  String
  networkId     String
  asset         String   @db.VarChar(20)
  amount        String
  invoiceId     String   @db.VarChar(255)
  scheme        String   @default("exact")
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  seller        Seller?  @relation(fields: [sellerId], references: [id])
  network       Network  @relation(fields: [networkId], references: [id])

  verifications PaymentVerification[]
  settlements   PaymentSettlement[]
  receipt       PaymentReceipt?

  @@index([invoiceId])
  @@index([buyerAddress])
  @@index([sellerId])
  @@index([createdAt])
  @@map("payment_requests")
}

// ─── Payment Verification ─────────────────────────────────────────────────────

model PaymentVerification {
  id                 String             @id @default(cuid())
  requestId          String
  verificationStatus VerificationStatus @default(pending)
  errorCode          String?            @db.VarChar(64)
  reason             String?
  signatureHash      String?            @unique @db.VarChar(128)
  nonce              String?            @unique @db.VarChar(128)
  payloadHash        String?            @db.VarChar(128)
  createdAt          DateTime           @default(now())

  request PaymentRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([signatureHash])
  @@index([nonce])
  @@map("payment_verifications")
}

enum VerificationStatus {
  pending
  accepted
  rejected
}

// ─── Payment Settlement ───────────────────────────────────────────────────────

model PaymentSettlement {
  id               String           @id @default(cuid())
  requestId        String
  settlementStatus SettlementStatus @default(pending)
  settlementId     String?          @unique @db.VarChar(128)
  txHash           String?          @unique @db.VarChar(128)
  feeAmount        String?
  referralCode     String?          @db.VarChar(50)
  developerShare   String?
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  request PaymentRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([txHash])
  @@index([settlementStatus])
  @@index([createdAt])
  @@map("payment_settlements")
}

enum SettlementStatus {
  pending
  processing
  confirmed
  failed
}

// ─── Payment Receipt ──────────────────────────────────────────────────────────

model PaymentReceipt {
  id              String   @id @default(cuid())
  requestId       String   @unique
  protocolVersion String   @default("x402-v2")
  responsePayload Json
  createdAt       DateTime @default(now())

  request PaymentRequest @relation(fields: [requestId], references: [id])

  @@map("payment_receipts")
}

// ─── Webhook Subscription ─────────────────────────────────────────────────────
// V2: webhookSecret stored encrypted (AES-256-GCM via secrets manager)
// V2: events is a PostgreSQL text[] — ['payment.verified', 'payment.settled', 'payment.failed']

model WebhookSubscription {
  id             String   @id @default(cuid())
  sellerId       String
  url            String
  events         String[] // PostgreSQL text[]
  secret         String   // Store encrypted in production (see docs/secrets-management.md)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  seller         Seller   @relation(fields: [sellerId], references: [id])
  deliveries     WebhookDelivery[]

  @@index([sellerId])
  @@map("webhook_subscriptions")
}

// ─── Webhook Delivery (full audit trail) ─────────────────────────────────────
// V2: httpStatus and responseBody added for debugging dead-lettered deliveries

model WebhookDelivery {
  id             String    @id @default(cuid())
  subscriptionId String
  event          String    @db.VarChar(64)
  payload        Json
  attempt        Int       @default(1)
  status         String    @default("pending") // pending | delivered | failed
  httpStatus     Int?
  responseBody   String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([event])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_deliveries")
}
