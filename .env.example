# ============================================================
# facilitatorx402 — Environment variables
# Copy to .env and fill in all required values.
# NEVER commit .env to git.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/facilitatorx402"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Blockchain ---
# Private key of the facilitator wallet (hex, 0x-prefixed)
FACILITATOR_PRIVATE_KEY="0xYOUR_PRIVATE_KEY_HERE"

# Primary RPC endpoint (Base mainnet)
RPC_URL="https://mainnet.base.org"

# Fallback RPC endpoint (optional, used if primary fails)
RPC_URL_FALLBACK=""

# Minimum confirmations before considering a tx confirmed
MIN_CONFIRMATIONS=2

# --- Fee engine ---
# Platform commission in basis points (50 = 0.5%)
PLATFORM_FEE_BPS=50

# Developer share in basis points of the platform fee (20 = 0.2%)
DEVELOPER_SHARE_BPS=20

# --- HTTP server ---
HOST="0.0.0.0"
PORT=3000

# --- Rate limiting ---
# Max requests per time window per IP
RATE_LIMIT_MAX=100
# Time window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# --- Security ---
# Optional Bearer token to protect GET /metrics
METRICS_TOKEN=""

# --- Logging ---
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# --- Environment ---
NODE_ENV="development"
