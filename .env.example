# ───────────────────────────────────────────────────────────────────────────────
# facilitatorx402 — Environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ───────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://x402:x402pass@localhost:5432/x402db"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Service ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SERVICE_VERSION=2.0.0

# ── Blockchain — Base mainnet (required) ──────────────────────────────────────
RPC_URL_BASE="https://mainnet.base.org"
RPC_URL_BASE_FALLBACK=""
FACILITATOR_PRIVATE_KEY="0xYOUR_PRIVATE_KEY_HERE"
FACILITATOR_WALLET_ADDRESS="0xYOUR_WALLET_ADDRESS_HERE"

# ── Blockchain — Optimism (optional, V2) ──────────────────────────────────────
ENABLE_OPTIMISM=false
RPC_URL_OPTIMISM="https://mainnet.optimism.io"
RPC_URL_OPTIMISM_FALLBACK=""

# ── Blockchain — Arbitrum (optional, V2) ──────────────────────────────────────
ENABLE_ARBITRUM=false
RPC_URL_ARBITRUM="https://arb1.arbitrum.io/rpc"
RPC_URL_ARBITRUM_FALLBACK=""

# ── Fee engine ────────────────────────────────────────────────────────────────
# Commission prélevée sur chaque settlement, en basis points (100 bps = 1%)
PLATFORM_FEE_BPS=50
# Fraction reversée au partenaire référent (en % de la commission plateforme)
DEVELOPER_SHARE_PCT=20

# ── Security ──────────────────────────────────────────────────────────────────
# Rate limiting — requêtes par IP par minute
RATE_LIMIT_MAX=60
# Rate limiting — requêtes par seller par minute
RATE_LIMIT_SELLER_MAX=120

# ── Dashboard opérateur (V2) ──────────────────────────────────────────────────
# Laisser vide pour désactiver le dashboard
DASHBOARD_TOKEN="your-secret-dashboard-token-here"

# ── x402 Protocol ─────────────────────────────────────────────────────────────
SUPPORTED_X402_VERSION=1
SUPPORTED_SCHEME=exact
