# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_VERSION=1.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://facilitator:password@localhost:5432/facilitatorx402

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Blockchain ───────────────────────────────────────────────────────────────
# Primary RPC endpoint
RPC_URL=https://mainnet.base.org
# Secondary RPC (failover)
RPC_URL_FALLBACK=https://base.publicnode.com
# Private key of the facilitator wallet (hex, no 0x prefix)
FACILITATOR_PRIVATE_KEY=your_private_key_here
# Facilitator wallet address
FACILITATOR_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Network & Asset ──────────────────────────────────────────────────────────
SUPPORTED_CHAIN_ID=8453
SUPPORTED_ASSET_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
SUPPORTED_ASSET_SYMBOL=USDC
SUPPORTED_ASSET_DECIMALS=6

# ─── Fee Engine ───────────────────────────────────────────────────────────────
PLATFORM_FEE_BPS=50
DEVELOPER_SHARE_PERCENT=20
# Monthly free volume in asset smallest unit (0 = no free tier)
FREE_MONTHLY_VOLUME=0

# ─── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT_VERIFY=100
RATE_LIMIT_SETTLE=50
RATE_LIMIT_GLOBAL=500
CLOCK_SKEW_TOLERANCE_SECONDS=30

# ─── Settlement ───────────────────────────────────────────────────────────────
CONFIRMATIONS_REQUIRED=1
SETTLEMENT_TIMEOUT_SECONDS=120
SETTLE_LOCK_TTL_SECONDS=60
RPC_MAX_RETRIES=3
RPC_CIRCUIT_BREAKER_THRESHOLD=3
RPC_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
